# ==========================================
# PeoplePay360 Production Environment Variables
# ==========================================

# Server Environment
NODE_ENV=production
PORT=5000

# Database Connection (PostgreSQL 14+)
# Example: postgresql://username:password@localhost:5432/peoplepay360?schema=public
# Or Render/Neon: postgresql://user:pass@ep-hostname.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peoplepay360?schema=public"

# Authentication & JWT
JWT_SECRET="replace-with-a-very-long-and-secure-random-secret-key-32-chars-min"
JWT_EXPIRES_IN="7d"

# CORS Configuration (Optional: set to specific domain in production or leave * for hackathon demos)
CORS_ORIGIN="*"

# Static Frontend Distribution Path (Optional, defaults to automatic detection)
# FRONTEND_DIST_PATH="../frontend/dist"
