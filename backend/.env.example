# ─── PeoplePay360 Backend Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/peoplepay360

# ── Authentication ────────────────────────────────────────────────────────────
# Use a long random string in production: openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# ── Frontend URL (for CORS) ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Company branding (used in PDF payslips) ───────────────────────────────────
COMPANY_NAME=PeoplePay360

# ── Email (optional — P2 feature) ────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM="PeoplePay360 <noreply@example.com>"
