# ─── PeoplePay360 Frontend Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# The Vite proxy in vite.config.ts forwards /api → http://localhost:5000
# so in development you typically don't need to set VITE_API_URL.

# Uncomment if you want to call the API directly (e.g., in production builds)
# VITE_API_URL=http://localhost:5000/api
